# Скопируйте этот файл в .env и при необходимости поправьте значения.

# Строка подключения к PostgreSQL (используется приложением и Alembic)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_db

# Секретный ключ для подписи JWT-токенов (в реальном проекте — длинная случайная строка)
SECRET_KEY=super-secret-change-me-please

# Алгоритм подписи и время жизни access-токена (в минутах)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Логировать SQL-запросы SQLAlchemy в консоль (true/false)
DB_ECHO=false
