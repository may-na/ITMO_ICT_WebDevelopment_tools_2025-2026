# Значения по умолчанию уже заданы прямо в docker-compose.yml (dev-окружение).
# Этот файл — справочный, для запуска вне Docker.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/finance_db
SECRET_KEY=docker-dev-secret-change-me
PARSER_URL=http://localhost:8001
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
